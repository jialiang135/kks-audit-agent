# 复制为 .env 并填入真实值；docker compose 会自动读取同目录 .env 做变量插值。
# .env 是隐藏文件，重新部署解压不会覆盖，AI 配置不会丢。
# （另一处配置位置 config/app_config.json 由 Web「AI 配置」页保存，deploy.sh 会保留它。）
# Do not commit a real API key into version control.

# 管理接口令牌（必填）：
# 保护 配置读写 / Skill 读写与上传 / 运行日志 / AI 连接测试 这几类管理接口。
# 未设置时这些接口一律返回 403（fail-closed）——否则攻击者可把 AI 地址改成自己的端点，
# 再用已保存的 API Key 触发 AI 测试，导致密钥外泄。
# 生成方式：openssl rand -hex 24
KKS_ADMIN_TOKEN=

# 端口绑定地址（重要）：
# 默认只绑 127.0.0.1，即服务仅本机可访问，不发布到所有宿主网卡。
# 需要从局域网/其他机器访问，取消下面这行注释并设为 0.0.0.0（或指定内网 IP，如 172.20.1.195）。
# 使用 0.0.0.0 时请务必保证上面的 KKS_ADMIN_TOKEN 已配置，否则管理接口会整体 403。
# KKS_BIND_ADDR=0.0.0.0

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ENABLED=false
# AI_TIMEOUT_SECONDS: 单次模型请求超时(秒)，10~300
# 2026-10-10 实测：真实批量(40 行/39 KB) 端点空闲时单批 28~35s → 90s 余量偏紧(并发跑时抖动会撞墙)，默认已提到 180
AI_TIMEOUT_SECONDS=180
# AI_REVIEW_MAX_CANDIDATES: 送审候选上限,0=不限制;>0 时按 P0>P1>P2 优先级截断
AI_REVIEW_MAX_CANDIDATES=0
# AI_SUMMARY_ENABLED: 单文件"AI 总体总结"开关,1=启用(默认),0=关闭(仅省一次模型调用)
# AI_NAME_CONCURRENCY: 「AI 补名称」的并发请求数,1~16（默认 3）
#   实测：该端点对**大请求**是吞吐瓶颈——并发 8 相比串行既没加速、又让 20 批里撞出 5 次超时
# AI_NAME_BATCH_SIZE: 「AI 补名称」每批行数,1~200（默认 40 → 请求体约 39 KB）
AI_NAME_CONCURRENCY=3
AI_NAME_BATCH_SIZE=40
AI_SUMMARY_ENABLED=1
# AI_TREND_SUMMARY_ENABLED: 台账"AI 跨文件趋势总结"开关,1=启用(默认),0=关闭
AI_TREND_SUMMARY_ENABLED=1
# KKS_ARTIFACT_RETENTION_DAYS: 审核产物(报告 HTML / 问题清单 Excel)保留天数。
# 默认 90 天；设 0 = 不自动清理。超期的 runs/<run_id>/ 目录会被删除，
# 台账记录仍然保留，但"报告"列会显示"已归档"，不能在线下载。
# 只删除名字符合 run_id 格式的目录，runs/ 下的其他目录不会被碰。
KKS_ARTIFACT_RETENTION_DAYS=90
# AI审查性能参数：保留完整证据和二次核验；0表示不截断候选。
AI_THINKING_MODE=disabled
AI_REVIEW_CONCURRENCY=4
AI_REVIEW_BATCH_SIZE=12
AI_REVIEW_CONTEXT_ROWS=12
AI_REVIEW_BRIEF_OUTPUT=false
