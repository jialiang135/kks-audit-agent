# 复制为 .env 并填入真实值；docker compose 会自动读取同目录 .env 做变量插值。
# .env 是隐藏文件，重新部署解压不会覆盖，AI 配置不会丢。
# （另一处配置位置 config/app_config.json 由 Web「AI 配置」页保存，deploy.sh 会保留它。）
# Do not commit a real API key into version control.

# 管理接口令牌（必填）：
# 保护 配置读写 / Skill 读写与上传 / 运行日志 / AI 连接测试 这几类管理接口。
# 未设置时这些接口一律返回 403（fail-closed）——否则攻击者可把 AI 地址改成自己的端点，
# 再用已保存的 API Key 触发 AI 测试，导致密钥外泄。
# 生成方式：openssl rand -hex 24
KKS_ADMIN_TOKEN=

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ENABLED=false
# AI_TIMEOUT_SECONDS: 单次模型请求超时(秒)，10~300
AI_TIMEOUT_SECONDS=90
# AI_REVIEW_MAX_CANDIDATES: 送审候选上限,0=不限制;>0 时按 P0>P1>P2 优先级截断
AI_REVIEW_MAX_CANDIDATES=0
# AI_SUMMARY_ENABLED: 单文件"AI 总体总结"开关,1=启用(默认),0=关闭(仅省一次模型调用)
AI_SUMMARY_ENABLED=1
# AI_TREND_SUMMARY_ENABLED: 台账"AI 跨文件趋势总结"开关,1=启用(默认),0=关闭
AI_TREND_SUMMARY_ENABLED=1
