# Do not put a real API key in this file.
# AI_REVIEW_MAX_CANDIDATES: 送审候选上限,0=不限制;>0 时按 P0>P1>P2 优先级截断
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ENABLED=false
# AI_REVIEW_BATCH_SIZE=10（未使用，保留兼容）
AI_REVIEW_MAX_CANDIDATES=0
AI_TIMEOUT_SECONDS=90
# AI_SUMMARY_ENABLED: 单文件"AI 总体总结"开关,1=启用(默认),0=关闭(仅省一次模型调用)
AI_SUMMARY_ENABLED=1
# AI_TREND_SUMMARY_ENABLED: 台账"AI 跨文件趋势总结"开关,1=启用(默认),0=关闭
AI_TREND_SUMMARY_ENABLED=1
